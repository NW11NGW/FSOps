<?xml version="1.0" encoding="Windows-1252"?>
<!--
  Source definition for the FSOps toolbar panel's registration with MSFS (icon, panel ID, default
  docking/size). This is NOT read directly by the simulator - it must be compiled into a binary
  InGamePanels/FSOpsPanel.spb by the MSFS SDK's fspackagetool.exe and the result checked into
  ../package/InGamePanels/FSOpsPanel.spb. See ../README.md for the exact command and why this step
  cannot be automated in this repository.

  Structure verified against a real, working community in-game toolbar panel
  (bymaximus/msfs2020-toolbar-window-template's InGamePanels.InGamePanelDefinition, the same
  toolbar-iframe technique the project's plan cites for Navigraph's panel and
  buzinin/msfs2024-efb-panel) - not guessed.

  FIXED 2026-08-12: url was "html_UI/InGamePanels/..." (capital UI), inherited verbatim from the
  2020-era reference template. The package's real folder on disk - and the layout.json
  PanelPackageInstaller regenerates on every install - both say "html_ui" (lower-case). The panel
  toolbar button registers and opens fine because that data lives in the compiled .spb's own
  property list and needs no file lookup, but the panel content came up entirely black in the
  player's first real MSFS 2024 session: the HTML file that url points at never resolved. This is
  the literal path baked into the compiled .spb, so the fix requires recompiling (see README) -
  unlike the toolbar icon fix below, which is a plain file addition. Confirmed by comparison
  against fsdreamteam-gsx-pro and fsltl-traffic-injector, two real installed MSFS 2024 packages on
  the same machine: both ship "html_ui" (lower-case) on disk and in layout.json throughout.
-->
<SimBase.Document Type="InGamePanels" version="1,0">
  <Filename>InGamePanel_FSOpsPanel.spb</Filename>
  <InGamePanels.InGamePanelDefinition
    id="PANEL_FSOPS_PANEL"
    Name="FSOpsPanel"
    url="html_ui/InGamePanels/FSOpsPanel/FSOpsPanel.html"
    resizeDirections="Both"
    minWidth="33"
    minHeight="24"
    defaultWidth="36"
    defaultHeight="27"
    defaultTop="33"
    defaultRight="2"
    icon="ICON_TOOLBAR_FSOPS_PANEL"
    buttonVisible="true">
  </InGamePanels.InGamePanelDefinition>
</SimBase.Document>
