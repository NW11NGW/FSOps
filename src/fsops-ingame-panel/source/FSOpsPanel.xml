<!--
  Project file for the MSFS SDK's fspackagetool.exe. This is the file the tool is pointed at - it
  cannot be pointed at the panel definition directly, which is what an earlier version of the
  README wrongly claimed. The tool reads this, follows it to PackageDefinitions\fsops-panel.xml,
  and that in turn compiles everything in PackageSources\ into the binary .spb the toolbar needs.

  Output goes to _out\ and intermediate files to _Temp\, both of which are build artefacts and are
  gitignored - the only file worth keeping is the compiled .spb, which is copied by hand into
  ..\package\InGamePanels\FSOpsPanel.spb and committed. See ..\README.md for the exact command.
-->
<Project Version="2" Name="fsops-panel" FolderName="Packages">
	<OutputDirectory>_out</OutputDirectory>
	<TemporaryOutputDirectory>_Temp</TemporaryOutputDirectory>
	<Packages>
		<Package>PackageDefinitions\fsops-panel.xml</Package>
	</Packages>
</Project>
