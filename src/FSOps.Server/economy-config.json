  // performance (primary), cancelled and skipped sectors (a bigger hit than a delay), and landing
  // quality (smallest weight). Magnitude is "noticeable but slow" - 40-60 sectors from 50 to 75.
  "reputation": {
    "baselineScore": 50.0,
    "alpha": 0.0137672955,
    "onTimeWeight": 0.8,
    "landingWeight": 0.2,
    "onTimeToleranceMinutes": 5.0,
