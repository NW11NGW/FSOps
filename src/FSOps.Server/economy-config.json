{
  "maxLoadFactor": 0.92,
  "captiveFareCeilingMultiple": 1.5,
  "postCaptiveElasticity": 2.5,
  "referenceFare": {
    "farePerNm": 0.12,
    "minimumFare": 65
  },
  "demand": {
    "catchmentLarge": 10.0,
    "catchmentMedium": 3.0,
    "catchmentSmall": 0.6,
    "catchmentOther": 0.2,
    "sweetSpotMinNm": 300,
    "sweetSpotMaxNm": 2500,
    "noAirMarketBelowNm": 50,
    "noAirMarketFloorFactor": 0.01,
    "shortHopFloorFactor": 0.08,
    "longHaulDecayPerNm": 0.00035,
    "minDistanceFactor": 0.12,
    "baseDemandPerCatchmentPoint": 45.0,
    "reputationBaselineScore": 50.0,
    "reputationSensitivity": 0.5,
    "reputationFloor": 0.3,
    "monthlySeasonality": [0.90, 0.88, 0.95, 1.00, 1.05, 1.15, 1.22, 1.20, 1.02, 0.95, 0.88, 1.05],
    "dayOfWeekMultiplier": [0.95, 1.05, 0.95, 0.90, 1.00, 1.15, 1.10]
  },
  "fuel": {
    "basePricePerKg": 0.85,
    "defaultRegionalMultiplier": 1.00,
    "regionalMultipliers": {
      "United Kingdom": 1.00,
      "United States": 0.85,
      "Germany": 1.05,
      "France": 1.05,
      "United Arab Emirates": 0.70,
      "Japan": 1.15,
      "Australia": 1.10,
      "Brazil": 1.20,
      "South Africa": 1.10
    },
    "volatilityAmplitude": 0.06,
    "noiseWindowDays": 5,
    // "Cost of carry" - real-world rule of thumb for extra burn from hauling extra fuel: ~3% of
    // the EXTRA mass (carried beyond a sector's own normal requirement) burned per hour it's on
    // board. Fuel tankering's counterweight alongside weight-based landing fees - see
    // docs/PLAN.md "Persistent fuel state and tankering", "the trade-off". Applied only to fuel
    // carried beyond a sector's own requirement, so a normal (non-tankering) flight's figures are
    // completely unaffected - see BlockFuelEstimatorWeightPenaltyTests.
    "costOfCarryRatePerHour": 0.03
  },
  "costs": {
    "landingFeeRate": { "large": 9.50, "medium": 5.00, "small": 2.25, "other": 1.00 },
    "handlingFeeRate": { "large": 6.50, "medium": 3.50, "small": 1.75, "other": 0.75 },
    "parkingFeeRate": { "large": 1.20, "medium": 0.65, "small": 0.30, "other": 0.15 },
    "passengerChargeRate": { "large": 12.00, "medium": 7.00, "small": 3.50, "other": 1.50 },
    "turnaroundFeeRate": { "large": 450, "medium": 220, "small": 90, "other": 40 },
    "maintenanceAccrualPerHour": 210,
    "crewCostPerHour": 340,
    "minimumCrewDutyHours": 1.0
  },
  // A-checks every 500 airframe hours, C-checks every 4,000 - see docs/PLAN.md "Maintenance" and
  // the Playstyle behaviour table. Interval/cost/condition figures are shared across both
  // playstyles ("same cycle... and same costs"); only aCheckDowntimeHours/cCheckDowntimeHours
  // differ, and come from each playstyle's own "maintenance" override block below.
  // aCheckCost/cCheckCost are DELIBERATE GAME-BALANCE FIGURES, not real A/C-check bills (which run
  // into six and seven figures) - sized to stay a genuine but affordable hit against a casually
  // flown airline's accumulated monthly surplus by the time the hours come due. Do not "correct"
  // them toward realistic figures for the same reason the starter lease rate isn't corrected - see
  // docs/PLAN.md "The starter lease is a deliberate game-balance number".
  "maintenance": {
    "aCheckIntervalHours": 500,
    "cCheckIntervalHours": 4000,
    "aCheckCost": 45000,
    "cCheckCost": 320000,
    "conditionDecayPerHour": 0.12,
    "aCheckConditionRestorePercent": 35
  },
  // Buying a used airframe - see docs/PLAN.md "Used aircraft - cheap to buy, expensive to run".
  // Shared across playstyles: the used-aircraft market doesn't depend on which playstyle the buyer
  // chose. priceMultiplier 0.55 = 45% cheaper than new; the saving is repaid by starting 70% of the
  // way into both maintenance cycles and 30 condition points below a fresh airframe.
  "usedAircraft": {
    "priceMultiplier": 0.55,
    "startingHoursSinceACheckFraction": 0.7,
    "startingHoursSinceCCheckFraction": 0.7,
    "startingConditionPercent": 70,
    "startingAirframeHours": 18000
  },
  // Selling an owned aircraft - see docs/PLAN.md "Selling an owned aircraft must lose money on the
  // spread". Shared across playstyles: what a worn airframe is worth on the secondhand market
  // doesn't depend on how realistically the SELLING airline chose to be billed elsewhere. Anchored,
  // not guessed - with these defaults a used aircraft bought at exactly usedAircraft's starting
  // state (70% condition, 70% into both maintenance cycles) and immediately resold values at
  // exactly 0.50 of the playstyle's new price, strictly below the 0.55 it cost to buy, so even a
  // used-aircraft flip loses money. newAircraftResaleFactor alone (0.80) already makes a
  // buy-new-sell-immediately round trip a loss before any wear is applied.
  "depreciation": {
    "newAircraftResaleFactor": 0.80,
    "conditionDepreciationWeight": 0.30,
    "cycleWearDepreciationWeight": 0.30,
    "groundedForMaintenancePenalty": 0.05,
    "minResaleFactor": 0.10
  },
  // Shared across both playstyles - the founding pilot's salary is already a realistic figure and
  // needs no game-balance treatment (see docs/PLAN.md "The starter lease is a deliberate
  // game-balance number"). Everything else that differs by playstyle (starting capital, lease
  // deposit term, starter lease rate, insurance) lives in the "casual"/"trueLife" blocks below -
  // see docs/PLAN.md "Playstyle - Casual vs True-life". A playstyle is a named set of overrides,
  // not a code path: EconomyConfigCatalog resolves one fully-merged EconomyConfig per playstyle at
  // load time, and nothing downstream branches on which one an airline chose.
  "airlineStartup": {
    "startingPilotMonthlySalary": 9000
  },
  "casual": {
    // Exactly what Chunk D shipped - unchanged by the playstyle split. Starting capital, the
    // 1-month lease deposit and the game-balance starter lease/insurance are what let one aircraft
    // flown casually (~1 leg/day) be genuinely profitable - see docs/PLAN.md "The progression
    // loop" and "Status after the progression-loop rebalance". DELIBERATE GAME-BALANCE FIGURES,
    // NOT REAL-WORLD RATES - do NOT "correct" leaseRates.A320/B738 or monthlyInsurancePerAircraft
    // toward realistic numbers, that reopens the unplayable-grind problem the 2026-08-08 rebalance
    // fixed. leaseDepositMonths itself is a pacing decision, not a fictional-number label - a
    // single month's deposit is a normal real-world lease term too.
    "airlineStartup": {
      // 60,000 covers the 30,000 lease deposit plus a month's cushion, and - the load-bearing part -
      // sits BELOW the price of a used airframe (~51,200), so a new airline cannot buy past the
      // progression loop before flying a single sector. This was 2,000,000 while Casual purchase
      // prices were still realistic and therefore unreachable; once they came down to ~93,100 new,
      // that same figure bought 39 used A320s on day one and the earn-your-second-aircraft loop
      // stopped existing. Starting lean is safe here precisely because one leg a day already nets
      // about 45,000/month - the airline is profitable from month one, so runway matters far less
      // than the temptation it removes.
      "startingCapital": 60000,
      "leaseDepositMonths": 1.0
    },
    // Every leasable type's monthly lease rate for this playstyle - the ONLY place lease pricing
    // is read from (EconomyConfig.LeaseRateFor); AircraftType.MonthlyLeaseRate in the seeded
    // catalogue is never used for pricing (see AircraftTypeSeeder.cs's class doc).
    //
    // DELIBERATE GAME-BALANCE FIGURES, NOT REAL-WORLD RATES (2026-08-08 catalogue-wide rebalance) -
    // every entry here is the SAME ~8% multiplier applied to trueLife's real rate below, so a 737
    // is never eleven times cheaper to lease than an A321 just because one happened to be the
    // starter type. A320/B738 are the two exceptions: hard-anchored at exactly 30,000 (not 8% of
    // their real rate, which would be ~30,400/31,200) because the whole Casual balance is anchored
    // to that one figure - see docs/PLAN.md "Casual pricing must scale the WHOLE catalogue". Do NOT
    // "correct" any of these toward trueLife's figures, for the same reason as A320/B738 - that
    // reopens the unplayable-grind problem the rebalance fixed, just for every OTHER type instead.
    "leaseRates": [
      { "icaoType": "A319", "monthlyRate": 28000 },
      { "icaoType": "A320", "monthlyRate": 30000 },
      { "icaoType": "A321", "monthlyRate": 33600 },
      { "icaoType": "A20N", "monthlyRate": 32800 },
      { "icaoType": "A21N", "monthlyRate": 36000 },
      { "icaoType": "B737", "monthlyRate": 27200 },
      { "icaoType": "B738", "monthlyRate": 30000 },
      { "icaoType": "B739", "monthlyRate": 32800 },
      { "icaoType": "B38M", "monthlyRate": 34400 },
      { "icaoType": "B752", "monthlyRate": 36800 },
      { "icaoType": "A332", "monthlyRate": 60000 },
      { "icaoType": "A333", "monthlyRate": 65600 },
      { "icaoType": "A359", "monthlyRate": 92000 },
      { "icaoType": "A388", "monthlyRate": 144000 },
      { "icaoType": "B763", "monthlyRate": 52000 },
      { "icaoType": "B77W", "monthlyRate": 116000 },
      { "icaoType": "B789", "monthlyRate": 84000 },
      { "icaoType": "B748", "monthlyRate": 104000 },
      { "icaoType": "E170", "monthlyRate": 14800 },
      { "icaoType": "E175", "monthlyRate": 16400 },
      { "icaoType": "E190", "monthlyRate": 19200 },
      { "icaoType": "E195", "monthlyRate": 20800 },
      { "icaoType": "CRJ7", "monthlyRate": 12800 },
      { "icaoType": "CRJ9", "monthlyRate": 14000 },
      { "icaoType": "AT42", "monthlyRate": 7600 },
      { "icaoType": "AT72", "monthlyRate": 9200 },
      { "icaoType": "DH8D", "monthlyRate": 10400 }
    ],
    // Casual's purchase-price multiplier - see EconomyConfig.PurchasePriceMultiplier's own doc.
    // Applied to AircraftType.PurchasePrice (the shared realistic figure, unchanged by playstyle)
    // to get what THIS playstyle actually charges. 0.00116 lands the starter A320 at ~55,100 new -
    // "near £55,000 new" per docs/PLAN.md - so a Used example (55% of that, see UsedAircraft below)
    // is ~30,305: affordable after roughly ten sectors' profit, matching the lease deposit it sits
    // beside. Unlike leaseRates above (a per-type list, since real lease rates vary too much
    // relative to their own value to derive from a single column), this is a SINGLE scalar derived
    // from AircraftType.PurchasePrice, so it scales automatically as the catalogue grows - a new
    // type never needs its own Casual purchase-price entry authored by hand.
    // 0.00196 puts a USED A320 at roughly 51,000 - about 17 sectors' profit at the ~3,016 a
    // typical short-haul sector nets, which is the pace the user chose (2026-08-08). It was 0.00116
    // (~10 sectors) briefly; that made a used airframe cost about the same as a lease deposit, so
    // leasing had almost no reason to exist. Do NOT tune this toward realism - see the game-balance
    // note above; it is deliberately a tiny fraction of a real transaction value.
    "purchasePriceMultiplier": 0.00196,
    "fleetFinance": {
      "monthlyInsurancePerAircraft": 6000
    },
    // Downtime measured in hours, not days - "a nuisance and a bill, not a fortnight of not
    // playing" (docs/PLAN.md's Playstyle behaviour table). Same cycle and cost as True-life above.
    "maintenance": {
      "aCheckDowntimeHours": 4,
      "cCheckDowntimeHours": 24
    },
    // Risk-based loan pricing - see docs/PLAN.md "Loan interest is set by the simulation, never by
    // the player". The player NEVER supplies a rate; LoanRateCalculator scales linearly from
    // baseAnnualRatePct (a loan that barely touches the airline's borrowing capacity) up to
    // capAnnualRatePct (a loan borrowed right up to the limit) - the cap is a hard ceiling that can
    // never be exceeded, asserted by a boundary test. Casual's friendlier 2.5%-5.0% band matches its
    // forgiving figures everywhere else in this block.
    // maxStartingLoanPrincipal: the largest STARTING loan (taken at airline creation, always priced
    // at capAnnualRatePct since a brand-new airline has zero trailing cash flow) AirlineEndpoints
    // will accept - see LoanConfig.MaxStartingLoanPrincipal's own doc for why this can't reuse
    // LoanEligibilityCalculator's cash-flow-based cap. 250,000 -> £4,718.31/month over 60 months,
    // 10.4% of the tested ~45,485 typical Casual monthly income and over 4x the 60,000 starting
    // capital - chosen by the user from worked numbers across three candidate cap bases.
    "loan": {
      "baseAnnualRatePct": 2.5,
      "capAnnualRatePct": 5.0,
      "maxStartingLoanPrincipal": 250000
    },
    // A virtual pilot's flight that can't fly (aircraft in maintenance, still away, or otherwise
    // unavailable) is skipped quietly under Casual - recorded in history, no financial penalty at
    // all. See docs/PLAN.md's Playstyle behaviour table and FlightStatus.Skipped.
    "unflyableSchedule": {
      "cancellationFee": 0
    },
    // Ending a lease before it would otherwise have been billed - see docs/PLAN.md "Returning a
    // lease early must cost something". A flat fee in months' rent on top of the pro-rata charge
    // for the current billing period already used - see LeaseEarlyTerminationConfig's own doc.
    "leaseEarlyTermination": {
      "feeMonths": 0.5
    },
    // Paying off a loan's full remaining balance early - see docs/PLAN.md "Paying a loan back...
    // Charge a modest early-settlement fee". Only closing a loan entirely carries this fee (never a
    // partial overpayment) - see LoanEarlySettlementConfig's own doc.
    "loanEarlySettlement": {
      "feePercentOfRemainingBalance": 0.02
    }
  },
  "trueLife": {
    // Real-world figures - see docs/PLAN.md "Playstyle - Casual vs True-life". leaseRates.A320/B738
    // are the realistic rates the Casual figures above were deliberately cut from (see
    // AircraftTypeSeeder.cs's class doc); the other four types are unchanged from Casual since they
    // were already realistic. leaseDepositMonths is the standard 2-month real-world lease deposit
    // term. startingCapital (2,500,000) is sized from the arithmetic, not guessed: the larger of the
    // two starter deposits (390,000 x 2 = 780,000 for the B738) plus roughly three months of one
    // aircraft's fixed costs at the worse-case starter lease (390,000 + 50,000 insurance + 9,000
    // salary = 449,000/month) as runway - "a deposit plus a few months of runway", per the plan, not
    // the ~44 months Casual affords while flying nothing. At real lease/insurance rates a single
    // aircraft flown casually (~1 leg/day) is deeply loss-making (break-even lands near 4-5
    // sectors/day - see docs/PLAN.md's "Before" column), so True-life's progression genuinely
    // depends on virtual pilots flying standing schedules, not on this starting capital alone.
    "airlineStartup": {
      "startingCapital": 2500000,
      "leaseDepositMonths": 2.0
    },
    // Real-world monthly operating-lease rates for every catalogue type - the figures Casual's own
    // list above is an ~8% multiple of (except the two anchored starter types).
    "leaseRates": [
      { "icaoType": "A319", "monthlyRate": 350000 },
      { "icaoType": "A320", "monthlyRate": 380000 },
      { "icaoType": "A321", "monthlyRate": 420000 },
      { "icaoType": "A20N", "monthlyRate": 410000 },
      { "icaoType": "A21N", "monthlyRate": 450000 },
      { "icaoType": "B737", "monthlyRate": 340000 },
      { "icaoType": "B738", "monthlyRate": 390000 },
      { "icaoType": "B739", "monthlyRate": 410000 },
      { "icaoType": "B38M", "monthlyRate": 430000 },
      { "icaoType": "B752", "monthlyRate": 460000 },
      { "icaoType": "A332", "monthlyRate": 750000 },
      { "icaoType": "A333", "monthlyRate": 820000 },
      { "icaoType": "A359", "monthlyRate": 1150000 },
      { "icaoType": "A388", "monthlyRate": 1800000 },
      { "icaoType": "B763", "monthlyRate": 650000 },
      { "icaoType": "B77W", "monthlyRate": 1450000 },
      { "icaoType": "B789", "monthlyRate": 1050000 },
      { "icaoType": "B748", "monthlyRate": 1300000 },
      { "icaoType": "E170", "monthlyRate": 185000 },
      { "icaoType": "E175", "monthlyRate": 205000 },
      { "icaoType": "E190", "monthlyRate": 240000 },
      { "icaoType": "E195", "monthlyRate": 260000 },
      { "icaoType": "CRJ7", "monthlyRate": 160000 },
      { "icaoType": "CRJ9", "monthlyRate": 175000 },
      { "icaoType": "AT42", "monthlyRate": 95000 },
      { "icaoType": "AT72", "monthlyRate": 115000 },
      { "icaoType": "DH8D", "monthlyRate": 130000 }
    ],
    // True-life keeps real figures throughout (docs/PLAN.md) - purchase price is charged exactly
    // as AircraftType.PurchasePrice reads, unmodified.
    "purchasePriceMultiplier": 1.0,
    "fleetFinance": {
      "monthlyInsurancePerAircraft": 50000
    },
    // Realistic downtime - A-check about a day, C-check about a fortnight (docs/PLAN.md's
    // Playstyle behaviour table: "A second aircraft becomes genuinely necessary"). Same cycle and
    // cost as Casual above.
    "maintenance": {
      "aCheckDowntimeHours": 24,
      "cCheckDowntimeHours": 336
    },
    // Realistic borrowing costs - hard-capped at 8% per docs/PLAN.md's playstyle table, above
    // Casual's 5% the same way every other True-life figure is realistic rather than game-balanced.
    // maxStartingLoanPrincipal: see the "casual" block's own comment above for why this exists
    // separately from the cash-flow-based mid-game cap. 5,000,000 -> £101,381.97/month over 60
    // months at the 8.0% cap rate - roughly 2x the 2,500,000 starting capital, matching Casual's
    // cap by the same capital-multiple; True-life has no solo-income figure to compare against
    // since a single aircraft flown casually is a real loss by design (see GET /airline/playstyles).
    "loan": {
      "baseAnnualRatePct": 4.0,
      "capAnnualRatePct": 8.0,
      "maxStartingLoanPrincipal": 5000000
    },
    // A virtual pilot's flight that can't fly is CANCELLED under True-life, with a real cost -
    // "clearly reported", per docs/PLAN.md's Playstyle behaviour table (see
    // FlightStatus.Cancelled). Sized as a modest multiple of a typical sector's fixed per-sector
    // costs (turnaround/handling), not punitive - it needs to bite a badly-planned schedule, not
    // bankrupt one bad week.
    "unflyableSchedule": {
      "cancellationFee": 350
    },
    // Harsher early-exit penalties than Casual, like every other True-life figure - see
    // leaseEarlyTermination/loanEarlySettlement's own docs in the "casual" block above.
    "leaseEarlyTermination": {
      "feeMonths": 1.0
    },
    "loanEarlySettlement": {
      "feePercentOfRemainingBalance": 0.04
    }
  },
  // Pilot rest/duty and minimum turnaround for the weekly schedule builder - see docs/PLAN.md
  // "Virtual pilot scheduling". Shared across playstyles: a duty day and a legal rest period are
  // working-time facts, not something that should differ by how realistically the player wants to
  // be billed. 10h rest / 13h max duty are ordinary short-haul crewing figures; 45 minutes covers a
  // realistic minimum turnaround (deplane, clean, board).
  "scheduling": {
    "minRestHoursBetweenDutyDays": 10,
    "maxDutyHoursPerDay": 13,
    "minTurnaroundMinutes": 45
  },
  "strategyProfiles": [
    { "profile": "LowCost", "referenceFareMultiplier": 0.75, "baselineLoadFactor": 0.76, "elasticity": 1.60, "costMultiplier": 0.85 },
