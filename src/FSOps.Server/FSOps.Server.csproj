<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FSOps.Core\FSOps.Core.csproj" />
    <ProjectReference Include="..\FSOps.Data\FSOps.Data.csproj" />
    <ProjectReference Include="..\FSOps.Sim\FSOps.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <!-- Read-only seed data (OurAirports CSVs and the VAT-Spy FIR boundary files, all
       gzip-compressed) lives in a repo-root data/ folder to keep it out of every project's own
       tree. It ships next to the built assembly so AppContext.BaseDirectory finds it the same way
       in dev and once published. The recursive glob already carries sub-folders through - a file
       at data/vatspy/X.gz links to data\vatspy\X.gz - so new bundled data needs no new item. -->
  <ItemGroup>
    <None Include="..\..\data\**\*.gz">
      <Link>data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- The VAT-Spy boundary data is CC BY-SA 4.0, unlike the public-domain OurAirports CSVs beside
       it, so its attribution notice has to travel with the files it covers rather than living only
       in the repository. Separate item because the glob above is deliberately .gz-only. -->
  <ItemGroup>
    <None Include="..\..\data\vatspy\ATTRIBUTION.txt">
      <Link>data\vatspy\ATTRIBUTION.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- The web UI is built into wwwroot by Vite. Copy it beside the built assembly so the
       executable serves it whether it is launched directly, from the installed location, or
       through dotnet run - the content root differs between those, but the output folder does not. -->
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Economy tuning constants. Same reasoning as wwwroot above: must land beside the built
       assembly regardless of how the app is launched, since the content root differs between
       dotnet run and a direct exe launch. -->
  <ItemGroup>
    <None Include="economy-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Development-only settings have no business in a shipped install. Kept in the build output
       (dotnet run needs it) but excluded from publish, so the installer - which copies the publish
       folder verbatim on purpose, precisely so the two can never drift - simply never sees it. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- The in-game panel package template (see src/fsops-ingame-panel/README.md) ships next to the
       built assembly, same reasoning as economy-config.json above - PanelPackageInstaller resolves
       it from AppContext.BaseDirectory so it works the same under "dotnet run" and a published exe.
       PanelPackageInstaller copies these files as-is into the player's Community folder; it never
       modifies anything under here. -->
  <ItemGroup>
    <None Include="..\fsops-ingame-panel\package\**">
      <Link>PanelTemplate\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <!-- Publish-only size trim: drops a dozen or so localisation folders from the self-contained
         output (see scripts/publish.ps1). No behavioural change - the app ships no localised
         resources of its own, and every string a user sees comes from the SPA. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
