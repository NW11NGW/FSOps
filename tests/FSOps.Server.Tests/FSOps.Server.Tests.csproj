<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorded telemetry of the flight that exposed the first-fix defect, shared with
         FSOps.Core.Tests rather than duplicated - one copy of the evidence, so the unit-level and
         pipeline-level regression tests can never drift onto different data. -->
    <Content Include="..\FSOps.Core.Tests\Flights\Fixtures\*.json"
             Link="Flights\Fixtures\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FSOps.Core\FSOps.Core.csproj" />
    <ProjectReference Include="..\..\src\FSOps.Data\FSOps.Data.csproj" />
    <ProjectReference Include="..\..\src\FSOps.Server\FSOps.Server.csproj" />
  </ItemGroup>

  <!-- The VAT-Spy boundary files, so VatSpyBoundarySourceTests can assert against the bytes that
       actually ship rather than only against fixtures. Worth the ~700 kB in the test output: a
       truncated download or a changed upstream format parses to zero boundaries, and zero
       boundaries is indistinguishable on screen from "no controllers online". The airports CSVs
       next door are deliberately NOT copied - nothing here reads them. -->
  <ItemGroup>
    <None Include="..\..\data\vatspy\*.gz">
      <Link>data\vatspy\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
